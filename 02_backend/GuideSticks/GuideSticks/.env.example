# Django runtime
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Choose one database mode.
# For local development without MySQL, set this to true.
DJANGO_USE_SQLITE=true

# For MySQL, set DJANGO_USE_SQLITE=false and configure the following values.
DJANGO_DB_ENGINE=django.db.backends.mysql
DJANGO_DB_NAME=guidesticks
DJANGO_DB_USER=guidesticks
DJANGO_DB_PASSWORD=replace-with-your-database-password
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=3306

# Optional cloud scene-explanation service
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
